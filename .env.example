# ==============================================================================
# Promius KPSS Super-Brain: Ortam Değişkenleri Şablonu (.env.example)
# Bu dosyayı .env olarak kopyalayın ve kendi anahtarlarınızı girin:
#   copy .env.example .env
# ==============================================================================

# YouTube Data API v3 (Opsiyonel - Kotanızı aşmamak veya arama limitleri için)
YOUTUBE_API_KEY=

# YouTube Bot Savunması İçin İsteğe Bağlı Çerez ve Tarayıcı Ayarları
YOUTUBE_COOKIES_FILE=data/cookies.txt
YOUTUBE_COOKIES_BROWSER=

# Yerel Ollama LLM Sunucu Adresi
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Varsayılan Yapay Zeka Modelleri
SUPER_BRAIN_MAIN_MODEL=qwen2.5:14b
SUPER_BRAIN_REASONING_MODEL=deepseek-r1:8b
SUPER_BRAIN_VISION_MODEL=llava
SUPER_BRAIN_EMBEDDING_MODEL=all-minilm

# Whisper / Konuşma Tanıma (cuda, cpu veya auto)
WHISPER_DEVICE=auto
WHISPER_MODEL_SIZE=tiny

# Ağ Güvenliği & CORS Ayarları (Virgülle ayrılmış liste)
CORS_ORIGINS=http://localhost:8500,http://127.0.0.1:8500,http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL / pgvector Ayarları (Docker veya yerel veritabanı)
POSTGRES_DB=kpss_brain
POSTGRES_USER=kpss_user
POSTGRES_PASSWORD=kpss_secret_password_2026
